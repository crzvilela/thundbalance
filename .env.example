# ThundBalance, FRONTEND (React + Vite). Copy to .env.local to run on your computer; on Vercel they are Environment Variables.
# Only NAMES and clearly FALSE example values here: never write a real key. Anything starting with VITE_ ends up in the public bundle,
# so it must never be a secret. The server variables (Render) are in backend/.env.example.

# [optional] address of the API. Default: the production API. For local development: http://localhost:8000
VITE_API_URL=http://localhost:8000
# [optional] e-mail of the administrator, only to decide which menu to show (the server checks the real role). Default: a placeholder.
VITE_ADMIN_EMAIL=admin@example.test
# [optional] key of the Google Maps / Places widget on the landing page (restrict it by address in Google Cloud). Without it the reviews box is hidden.
VITE_GOOGLE_MAPS_API_KEY=example-key-not-real
