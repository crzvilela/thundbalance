# ThundBalance, BACKEND (FastAPI). Variables of the server (Render) or of your own computer.
# This file only holds NAMES and clearly FALSE example values: never write a real key, password or address here.
# [required] the server does not work without it / [optional] it has a default / [obsolete] the code no longer reads it.
# The frontend variables (VITE_*) are in ../.env.example.

# ---------------------------------------------------------------------------------------------------- database
# [required in production] connection string of the PostgreSQL database. Without it the server uses the LOCAL development database
# (host localhost, database thundbalance, user postgres) and the tests only run against a local one.
DATABASE_URL=postgresql://user:password@db.example.test:5432/thundbalance
# [optional, local only] password of the local development database when DATABASE_URL is not set.
DB_PASSWORD=change-me-local-only

# ---------------------------------------------------------------------------------------------------- who is the admin, login
# [required] e-mail of the ONE administrator account (compared with the e-mail of the Firebase login). Default in the code: a placeholder.
ADMIN_EMAIL=admin@example.test
# [optional] Firebase project id used to check the tokens of the logins. Default: thundbalance.
FIREBASE_PROJECT_ID=example-project
# [required to create / delete client logins from the admin] path to the Firebase service-account JSON file on the server
# (the file itself never goes in the repository).
FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase-service-account.example.json
# [optional] seconds the answer "this login was not revoked" is remembered. Default: 15.
REVOCATION_CACHE_SECONDS=15

# ---------------------------------------------------------------------------------------------------- web: addresses, CORS, docs
# [required in production] extra origins allowed by CORS, comma separated (the production site is always allowed). Never "*".
CORS_ORIGINS=https://www.example.test
# [optional] public address of the site, used in the links of the e-mails. Default: the production address. (SITE_URL is the older name.)
FRONTEND_URL=https://www.example.test
SITE_URL=
# [optional] public address of this API (photos, calendar links). Default: the production API address.
PUBLIC_API_URL=https://api.example.test
# [optional] "development" (also read as ENV) turns on localhost for CORS and for photo addresses. Leave empty in production.
ENVIRONMENT=
ENV=
# [optional] 1 = serve /docs, /redoc and /openapi.json. NEVER in production. Default: off.
ENABLE_API_DOCS=
# [optional] number of proxies in front of the server whose X-Forwarded-For is trusted (Render: 1). Default: 1.
TRUSTED_PROXY_HOPS=1
# [optional] logging level. Default: INFO.
LOG_LEVEL=INFO
# [optional] JSON with the size limits of the landing page content (see landing_limits.py). Default: the limits of the code.
LANDING_LIMITS=

# ---------------------------------------------------------------------------------------------------- e-mail
# [optional] 'gmail_api' (Gmail API from the studio's domain, with the service account) or 'legacy' (Apps Script). Default: legacy.
MAIL_PROVIDER=legacy
MAIL_FROM_EMAIL=studio@example.test
MAIL_FROM_NAME=Studio Example
MAIL_REPLY_TO=studio@example.test
# [optional, legacy sender] address and shared secret of the Apps Script web app. See docs/TRIAL_EMAIL_SETUP.md.
TRIAL_EMAIL_WEBHOOK_URL=https://script.example.test/exec
TRIAL_EMAIL_WEBHOOK_SECRET=change-me-example
# [optional] who receives EVERY internal notice (new trial, reschedule, contact message, deletion request...), comma separated.
# Default: the studio's address in the code.
TEAM_NOTIFICATION_EMAILS=team@example.test
# [optional] address of the logo in the e-mails; EMAIL_ALLOW_LOCAL_URLS=1 lets e-mails link to localhost (development only).
EMAIL_LOGO_URL=
EMAIL_ALLOW_LOCAL_URLS=
# [obsolete] no longer read: delete it from Render if it is still there (replaced by TEAM_NOTIFICATION_EMAILS).
TRIAL_NOTIFY_TO=

# ---------------------------------------------------------------------------------------------------- Google Calendar
# [required for the calendar] id of the studio's Google Calendar.
GOOGLE_CALENDAR_ID=calendar-id@group.calendar.example.test
# [required for the calendar] the service account as plain JSON in one variable (the key itself never goes in the repository).
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"example","private_key":"-----EXAMPLE ONLY-----"}
# [optional] account the server acts as for the calendar guests (domain-wide delegation). Default: the studio's address in the code.
GOOGLE_IMPERSONATE_EMAIL=studio@example.test
# [optional] off / 0 / false switches OFF the check of sessions deleted in Google Calendar (every 10 minutes). Default: on.
GOOGLE_DELETE_SYNC=
# [optional] true = the client calendar (feed and .ics links) is available. Default: off.
CLIENT_CALENDAR_ENABLED=
# [optional] hours before a session after which the client can no longer ask to move it. Default: 24.
RESCHEDULE_MIN_HOURS_BEFORE=24

# ---------------------------------------------------------------------------------------------------- limits and caches (all optional)
TRIAL_IP_LIMIT=5
TRIAL_IP_WINDOW_SECONDS=3600
TRIAL_EMAIL_LIMIT=3
TRIAL_EMAIL_WINDOW_SECONDS=86400
CONTACT_IP_LIMIT=5
CONTACT_EMAIL_LIMIT=3
CONTACT_WINDOW_SECONDS=3600
TOKEN_RATE_LIMIT=40
TOKEN_RATE_WINDOW_SECONDS=300
# requests per connection per minute on the public availability routes. Default: 60.
AVAILABILITY_RATE_LIMIT=60
# seconds the public free times / the packs and prices are kept in memory. Defaults: 60 / 30.
SCHEDULE_CACHE_SECONDS=60
PRICING_CACHE_SECONDS=30

# ---------------------------------------------------------------------------------------------------- retention of data (RGPD)
# [optional] the policy below only runs when this is true. Default: off. docs/DATA_RETENTION.md explains it.
RETENTION_ENABLED=
# [optional] off / false switches the whole daily job off (it also repeats unfinished deletions). Default: on.
RETENTION_JOB=
RETENTION_CONTACT_DAYS=365
RETENTION_TRIAL_DAYS=365
RETENTION_EMAIL_LOG_DAYS=180

# ---------------------------------------------------------------------------------------------------- monitoring and keep-alive (docs/MONITORING.md)
# [optional] off = no alert e-mails to the team (the "Estado del sistema" page keeps working). Default: on.
MONITOR_EMAILS=
# [optional] off = no internal keep-alive (a thread that asks the service's own /health every 10 minutes in production). Default: on.
KEEP_ALIVE=
# [set by Render itself, do not write it] public address of the service (used by the keep-alive) and the commit it was built from (the release shown with each error).
RENDER_EXTERNAL_URL=https://example.onrender.com
RENDER_GIT_COMMIT=0123456789abcdef

# ---------------------------------------------------------------------------------------------------- error reporting (optional)
# [optional] Sentry. Without a DSN nothing is sent. No personal data is ever sent.
SENTRY_DSN=https://public@sentry.example.test/1
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
